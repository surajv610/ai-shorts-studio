# AI Shorts Studio V1 — environment configuration
# Copy this file to `.env` and fill in your own values. Never commit `.env`.

# =========================================================================
# LLM PROVIDER
# =========================================================================
# provider: "mock" (default, no cost), "openai", or "gemini"
# Recommended for real use: gemini (set GEMINI_API_KEY below)
LLM_PROVIDER=mock
# For OpenAI: LLM_API_KEY=sk-...
# For Gemini: GEMINI_API_KEY=<your-key> (see GOOGLE GEMINI section below)
# LLM_API_KEY is also accepted for Gemini via backward-compat fallback.
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
# Request timeout in seconds (default 120)
# LLM_TIMEOUT=120

# Backward-compatible aliases (older env keys) are still honored if the
# LLM_* values above are empty:
#   AI_PROVIDER, AI_API_KEY, AI_MODEL, AI_BASE_URL, AI_TIMEOUT

# =========================================================================
# IMAGE PROVIDER
# =========================================================================
# provider: "mock" (default, no cost) or "google" (Gemini Nano Banana,
#   consumed via the Gemini API generateContent endpoint, costs credits).
# Model default: gemini-3.1-flash-image (override with IMAGE_MODEL).
# The API key below may be shared with the video provider.
IMAGE_PROVIDER=mock
IMAGE_API_KEY=
IMAGE_MODEL=
IMAGE_BASE_URL=
# Timeout in seconds for each generateContent call (default 120)
# IMAGE_TIMEOUT=120

# =========================================================================
# VIDEO PROVIDER
# =========================================================================
# provider: "mock" (default, no cost) or "google" (Veo image-to-video via the
#   Gemini API predictLongRunning endpoint, costs credits).
# Model default: veo-3.1-generate-preview (override with VIDEO_MODEL).
VIDEO_PROVIDER=mock
VIDEO_API_KEY=
VIDEO_MODEL=
VIDEO_BASE_URL=
# Submit-timeout in seconds (default 60)
# VIDEO_TIMEOUT=60
# How long to wait for a generated video before giving up (default 1800)
# VIDEO_POLL_TIMEOUT=1800
# How often to poll the operation endpoint (default 10)
# VIDEO_POLL_INTERVAL=10

# =========================================================================
# GOOGLE GEMINI (shared) — used by LLM (when LLM_PROVIDER=gemini),
# IMAGE_API_KEY, and VIDEO_API_KEY above when either is left empty.
#
# IMPORTANT:
#  - Consumer Gemini / ChatGPT / Google One subscriptions do NOT give API
#    credits. You need a separate Google Cloud / AI Studio API key.
#  - When LLM_PROVIDER=gemini the app will NEVER silently fall back to
#    OpenAI or any other provider. If the key is invalid or quota is
#    exhausted, generation stops and an error is reported.
#  - Run the optional smoke test (costs 1 small request) with:
#      GEMINI_API_KEY='your-key' python3 scripts/gemini_smoke_test.py
# =========================================================================
GEMINI_API_KEY=
# (Legacy alias also honored: GOOGLE_API_KEY)

# =========================================================================
# DATABASE / STORAGE
# =========================================================================
# Optional. V1 persists projects to JSON files under storage/projects/.
# If you later add a SQL database you may point DATABASE_URL at it here.
DATABASE_URL=
# Optional. Override the base storage directory used by providers.
STORAGE_PATH=

# =========================================================================
# RETRY (optional)
# =========================================================================
# RETRY_ATTEMPTS=3
# RETRY_BACKOFF=1.0
# RETRY_MAX_DELAY=30.0
